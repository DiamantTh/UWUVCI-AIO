<Page x:Class="UWUVCI.App.Uno.Views.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UWUVCI.App.Uno.Views"
      xmlns:vm="using:UWUVCI.App.Uno.ViewModels"
      Background="{ThemeResource AppBackgroundBrush}">

  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility"        Invert="False"/>
    <local:BoolToVisibilityConverter x:Key="InvertBoolToVisibility"  Invert="True"/>
  </Page.Resources>

  <ScrollViewer Padding="24">
    <StackPanel Spacing="20" MaxWidth="720">

      <!-- Title + actions -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Tools"
                   FontSize="24" FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource AppTextBrush}"/>
        <Button Grid.Column="1" Content="Refresh"
                Click="Refresh_Click"
                Background="{ThemeResource AppSurfaceAltBrush}"
                Foreground="{ThemeResource AppTextBrush}"
                Margin="0,0,8,0" Padding="14,7" CornerRadius="6"/>
        <Button Grid.Column="2" Content="Download all missing"
                Click="DownloadAll_Click"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InvertBoolToVisibility}}"
                Background="{ThemeResource AppAccentBrush}"
                Foreground="{ThemeResource AppTextOnAccentBrush}"
                Padding="14,7" CornerRadius="6"/>
      </Grid>

      <!-- Status line -->
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 Foreground="{ThemeResource AppMutedTextBrush}" FontSize="12"/>

      <!-- Empty state -->
      <TextBlock Text="No tool manifest found. Place a tools.toml in your tools directory."
                 Foreground="{ThemeResource AppMutedTextBrush}"
                 TextWrapping="Wrap"
                 Visibility="{x:Bind ViewModel.HasTools, Mode=OneWay, Converter={StaticResource InvertBoolToVisibility}}"/>

      <!-- Tool rows -->
      <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToolRowViewModel">
            <Border Background="{ThemeResource AppCardBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="14,10" Margin="0,0,0,6">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status icon -->
                <TextBlock Grid.Column="0"
                           Text="{x:Bind StatusIcon, Mode=OneWay}"
                           FontSize="16" VerticalAlignment="Center"
                           Foreground="{ThemeResource AppTextBrush}"/>

                <!-- Name + status -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Name}"
                             FontWeight="SemiBold"
                             Foreground="{ThemeResource AppTextBrush}"/>
                  <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                             FontSize="12"
                             Foreground="{ThemeResource AppMutedTextBrush}"/>
                  <TextBlock Text="{x:Bind ErrorText, Mode=OneWay}"
                             FontSize="12" Foreground="#FF6B6B"
                             TextWrapping="Wrap"
                             Visibility="{x:Bind HasError, Mode=OneWay}"/>
                </StackPanel>

                <!-- Progress bar (visible while downloading) -->
                <ProgressBar Grid.Column="2"
                             Value="{x:Bind DownloadProgress, Mode=OneWay}"
                             Minimum="0" Maximum="100" Width="120"
                             VerticalAlignment="Center"
                             Foreground="{ThemeResource AppAccentBrush}"
                             Background="{ThemeResource AppSurfaceAltBrush}"
                             Visibility="{x:Bind IsDownloading, Mode=OneWay}"/>

                <!-- Download button -->
                <Button Grid.Column="3"
                        Content="Download"
                        Tag="{x:Bind Name}"
                        Click="DownloadTool_Click"
                        IsEnabled="{x:Bind CanDownload, Mode=OneWay}"
                        Background="{ThemeResource AppSurfaceAltBrush}"
                        Foreground="{ThemeResource AppTextBrush}"
                        Padding="12,6" CornerRadius="4"
                        VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</Page>
