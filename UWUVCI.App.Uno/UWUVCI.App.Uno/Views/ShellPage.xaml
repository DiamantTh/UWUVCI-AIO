<Page x:Class="UWUVCI.App.Uno.Views.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UWUVCI.App.Uno.Views"
      xmlns:vm="using:UWUVCI.App.Uno.ViewModels"
      Background="{ThemeResource AppBackgroundBrush}">

  <Grid>
    <Grid.ColumnDefinitions>
      <!-- Sidebar -->
      <ColumnDefinition Width="200"/>
      <!-- Content -->
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===== Sidebar ===== -->
    <Border Grid.Column="0"
            Background="{ThemeResource AppMenuBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,0,1,0">
      <StackPanel Orientation="Vertical" Spacing="4" Padding="8,16,8,8">

        <!-- App title -->
        <TextBlock Text="UWUVCI"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{ThemeResource AppTextBrush}"
                   Margin="8,0,0,16"/>

        <!-- Navigation items -->
        <ItemsControl x:Name="NavItems"
                      ItemsSource="{x:Bind ViewModel.Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationItem">
              <Button Tag="{x:Bind}"
                      Click="NavButton_Click"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource NavSelectedBrushConverter}}"
                      Padding="10,8"
                      CornerRadius="6"
                      Margin="0,2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{x:Bind Glyph}"
                             FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                             FontSize="16"
                             Foreground="{ThemeResource AppTextBrush}"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="{x:Bind Label}"
                             Foreground="{ThemeResource AppTextBrush}"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </Border>

    <!-- ===== Content frame ===== -->
    <Frame x:Name="ContentFrame"
           Grid.Column="1"
           Background="{ThemeResource AppBackgroundBrush}"/>

  </Grid>

  <Page.Resources>
    <local:NavSelectedBrushConverter x:Key="NavSelectedBrushConverter"/>
  </Page.Resources>

</Page>
