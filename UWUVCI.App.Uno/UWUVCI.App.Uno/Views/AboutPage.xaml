<Page x:Class="UWUVCI.App.Uno.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource AppBackgroundBrush}">
  <StackPanel Padding="24" Spacing="12">
    <TextBlock Text="About" FontSize="24" FontWeight="SemiBold"
               Foreground="{ThemeResource AppTextBrush}"/>
    <TextBlock Text="UWUVCI – Wii U Virtual Console Injector"
               Foreground="{ThemeResource AppMutedTextBrush}"/>
    <TextBlock Text="Rewrite: Uno Platform / .NET 10"
               Foreground="{ThemeResource AppMutedTextBrush}"/>
  </StackPanel>
</Page>
